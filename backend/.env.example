DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
FRONTEND_ORIGIN=http://localhost:3000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Empty DATABASE_URL uses SQLite ONLY for isolated local preview.
# Supabase Session pooler example (SSL required). Replace placeholders locally in .env — never commit secrets:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
